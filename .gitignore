# --- Flutter / Dart ---
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
.vscode/

# FVM: only .fvmrc is versioned
.fvm/

# Pub
# pubspec.lock IS versioned for the app (reproducible builds); pure Dart
# packages (packages/*) keep theirs out by convention:
packages/*/pubspec.lock

# --- Supabase CLI ---
# Estado local do `supabase link` (ref do projeto, credenciais de sessão).
supabase/.temp/
supabase/.branches/

# --- Deno / edge functions ---
# deno.lock É versionado (build reproduzível); node_modules é artefato de
# máquina, criado pelo nodeModulesDir=auto de que o supabase-js depende.
supabase/functions/node_modules/

# --- Android ---
**/android/.gradle/
**/android/local.properties
**/android/captures/
**/android/app/release/
**/android/.kotlin/

# --- iOS / macOS ---
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/ephemeral/
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/Generated.xcconfig
**/DerivedData/
*.xcuserstate

# --- Secrets: NEVER in the repo ---
*.jks
*.keystore
key.properties
.env
.env.*
**/google-services.json
**/GoogleService-Info.plist

# --- OS noise ---
.DS_Store
Thumbs.db
