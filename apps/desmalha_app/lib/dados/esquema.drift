-- Desmalha — banco local. Arquivo cifrado com SQLCipher (ver conexao_cifrada.dart).
--
-- Fonte: "Resultado: Revisar modelagem de dados para local-first (ago/2026)"
-- no Notion — o DDL daqui é o de lá, com as tabelas reordenadas para que
-- nenhuma referência aponte para trás e com DOIS desvios documentados nos
-- comentários de `transacoes`, exigidos pela decisão de deduplicação de
-- 17/ago/2026 (posterior à modelagem, prevalece).
--
-- Convenções invioláveis: dinheiro = INTEGER centavos | percentual = INTEGER
-- pontos-base | data civil = TEXT 'YYYY-MM-DD' | competência = TEXT 'YYYY-MM'
-- instante = INTEGER epoch ms UTC | booleano = INTEGER 0/1
-- id de entidade do usuário = TEXT UUIDv7 (ordenável por tempo)
--
-- PRAGMA foreign_keys = ON é por conexão e vive no beforeOpen (banco.dart).
-- Sem ele, toda FK deste arquivo é decorativa.

-- ─── Catálogo versionado (cache do servidor, só-leitura no app) ─────

CREATE TABLE cat_versoes (
    catalogo     TEXT NOT NULL PRIMARY KEY CHECK (catalogo IN
                 ('irpf','parametros','feriados','rubricas','profissoes','parsers')),
    versao       INTEGER NOT NULL,
    publicado_em INTEGER NOT NULL,
    baixado_em   INTEGER NOT NULL,
    hash         TEXT NOT NULL
) AS CatVersao;

CREATE TABLE cat_tabelas_irpf (
    id                          INTEGER NOT NULL PRIMARY KEY,
    vigencia_inicio             TEXT NOT NULL,
    vigencia_fim                TEXT,
    fonte_legal                 TEXT NOT NULL,
    deducao_dependente_centavos INTEGER NOT NULL
) AS CatTabelaIrpf;

CREATE TABLE cat_faixas_irpf (
    tabela_id                INTEGER NOT NULL REFERENCES cat_tabelas_irpf(id),
    ordem                    INTEGER NOT NULL,
    limite_superior_centavos INTEGER,          -- NULL na última faixa
    aliquota_bp              INTEGER NOT NULL, -- 27,5% = 2750
    parcela_deduzir_centavos INTEGER NOT NULL,
    PRIMARY KEY (tabela_id, ordem)
) AS CatFaixaIrpf;

CREATE TABLE cat_parametros_fiscais (
    chave            TEXT NOT NULL,   -- 'desconto_simplificado_mensal',
    vigencia_inicio  TEXT NOT NULL,   -- 'trava_home_office_pct', 'darf_minimo',
    vigencia_fim     TEXT,            -- 'isencao_2026_teto', 'redutor_2026_*'
    valor            INTEGER NOT NULL,
    unidade          TEXT NOT NULL CHECK (unidade IN ('centavos','bp','inteiro')),
    fonte_legal      TEXT NOT NULL,
    status_validacao TEXT NOT NULL
                     CHECK (status_validacao IN ('validado','pendente_contador')),
    PRIMARY KEY (chave, vigencia_inicio)
) AS CatParametroFiscal;

CREATE TABLE cat_feriados_bancarios (
    data TEXT NOT NULL PRIMARY KEY,
    nome TEXT NOT NULL
) AS CatFeriadoBancario;

CREATE TABLE cat_rubricas (
    codigo                   TEXT NOT NULL PRIMARY KEY,
    nome                     TEXT NOT NULL,
    dedutivel                INTEGER NOT NULL,
    trava_home_office        INTEGER NOT NULL DEFAULT 0,
    exige_validacao_contador INTEGER NOT NULL DEFAULT 0,
    ordem                    INTEGER,
    ativo                    INTEGER NOT NULL DEFAULT 1
) AS CatRubrica;

CREATE TABLE cat_profissoes (
    codigo        TEXT NOT NULL PRIMARY KEY,
    nome          TEXT NOT NULL,
    regulamentada INTEGER NOT NULL,   -- ativa exigência de CPF do pagador
    conselho      TEXT,
    mei_permitido INTEGER,            -- NULL = validar; alerta de radar
    ativo         INTEGER NOT NULL DEFAULT 1
) AS CatProfissao;

CREATE TABLE cat_perfis_parser (
    codigo         TEXT NOT NULL PRIMARY KEY,   -- 'nubank_csv_v2', 'itau_ofx'
    banco_nome     TEXT NOT NULL,
    formato        TEXT NOT NULL CHECK (formato IN ('ofx','csv')),
    definicao_json TEXT NOT NULL,
    versao         INTEGER NOT NULL
) AS CatPerfilParser;

-- ─── Perfil e conformidade ──────────────────────────────────────────

CREATE TABLE perfil (
    id                  INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),  -- linha única
    usuario_remoto_id   TEXT,            -- auth.users.id; NULL antes do login
    nome                TEXT NOT NULL,
    cpf                 TEXT NOT NULL,   -- claro dentro do arquivo cifrado
    profissao_codigo    TEXT REFERENCES cat_profissoes(codigo),
    exige_cpf_pagador   INTEGER NOT NULL DEFAULT 0,
    onboarding_completo INTEGER NOT NULL DEFAULT 0,
    codigo_recuperacao_confirmado_em INTEGER,
    criado_em           INTEGER NOT NULL,
    atualizado_em       INTEGER NOT NULL
) AS PerfilLocal;

CREATE TABLE aceites_termos_local (      -- espelho; o registro que vale está no servidor
    documento      TEXT NOT NULL CHECK (documento IN ('termos_uso','politica_privacidade')),
    versao         TEXT NOT NULL,
    aceito_em      INTEGER NOT NULL,
    sincronizado   INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (documento, versao)
) AS AceiteTermosLocal;

-- ─── Origem dos dados ───────────────────────────────────────────────

CREATE TABLE contas_bancarias (
    id            TEXT NOT NULL PRIMARY KEY,
    apelido       TEXT NOT NULL,
    banco_codigo  TEXT,
    origem        TEXT NOT NULL DEFAULT 'manual'
                  CHECK (origem IN ('manual','open_finance')),   -- open_finance = Fase 2
    ativa         INTEGER NOT NULL DEFAULT 1,
    criado_em     INTEGER NOT NULL
) AS ContaBancaria;

CREATE TABLE importacoes (
    id                   TEXT NOT NULL PRIMARY KEY,
    conta_id             TEXT NOT NULL REFERENCES contas_bancarias(id),
    formato              TEXT NOT NULL CHECK (formato IN ('ofx','csv')),
    nome_arquivo         TEXT NOT NULL,
    hash_arquivo         TEXT NOT NULL,          -- SHA-256 do arquivo
    parser_codigo        TEXT,                   -- perfil de banco usado
    parser_versao        INTEGER,
    previa_json          TEXT,                   -- preenchido em 'previa', NULL após confirmar
    periodo_inicio       TEXT,
    periodo_fim          TEXT,
    total_linhas         INTEGER,
    total_importadas     INTEGER,
    total_duplicadas     INTEGER,
    total_ignoradas      INTEGER,
    status               TEXT NOT NULL DEFAULT 'previa'
                         CHECK (status IN ('previa','confirmada','descartada','erro')),
    erro_detalhe         TEXT,
    criado_em            INTEGER NOT NULL
) AS Importacao;

CREATE UNIQUE INDEX uq_importacao_hash
    ON importacoes (hash_arquivo) WHERE status = 'confirmada';

-- ⚠️ Dois desvios da modelagem de ago/2026, exigidos pela decisão de
-- deduplicação de 17/ago/2026 (card "Deduplicação de transações entre
-- importações"), que é posterior e prevalece:
--
-- 1. `uq_transacoes_fitid` (UNIQUE em conta_id+fitid) virou índice comum.
--    A regra nova admite persistir dois lançamentos com o MESMO fitid: é o
--    veredito `identificadorRepetidoNoArquivo`, em que o banco desrespeita a
--    própria especificação e quem decide manter é o usuário na prévia. Um
--    UNIQUE aqui transformaria essa decisão legítima em erro de banco. O
--    `conciliarImportacao` do desmalha_core já trata multiplicidade dos dois
--    lados, e a porta contra importar o mesmo ARQUIVO duas vezes é
--    `uq_importacao_hash` + a transição única previa→confirmada.
--
-- 2. `dedupe_hash` (e seu UNIQUE) saiu. Um hash único de (data, valor,
--    descrição) proibiria dois Pix legítimos de mesmo valor, mesmo dia e
--    mesmo remetente — exatamente o caso que a trava de CONTAGEM da regra
--    nova existe para proteger. A chave composta é calculada pelo
--    desmalha_core a partir das colunas cruas; guardar um hash redundante
--    só criaria uma segunda fonte de verdade para divergir.
CREATE TABLE transacoes (
    id                   TEXT NOT NULL PRIMARY KEY,
    conta_id             TEXT NOT NULL REFERENCES contas_bancarias(id),
    importacao_id        TEXT REFERENCES importacoes(id),
    data                 TEXT NOT NULL,
    valor_centavos       INTEGER NOT NULL,       -- >0 crédito, <0 débito
    descricao_raw        TEXT NOT NULL,          -- linha original, imutável
    fitid                TEXT,                   -- id único do OFX / Identificador do CSV
    contraparte_nome_raw TEXT,
    contraparte_doc      TEXT,
    contraparte_tipo     TEXT CHECK (contraparte_tipo IN ('pf','pj','desconhecido')),
    criado_em            INTEGER NOT NULL
) AS Transacao;

CREATE INDEX idx_transacoes_fitid
    ON transacoes (conta_id, fitid) WHERE fitid IS NOT NULL;
CREATE INDEX idx_transacoes_data ON transacoes (data);

-- Fato bancário ≠ interpretação fiscal: quem muda de ideia reclassifica o
-- lançamento (camada fiscal), nunca edita a transação. Sem backend, a
-- garantia vive no próprio banco.
CREATE TRIGGER trg_transacoes_imutaveis BEFORE UPDATE ON transacoes
BEGIN
    SELECT RAISE(ABORT, 'transacao é imutável: reclassifique o lançamento');
END;

-- ─── Camada fiscal ──────────────────────────────────────────────────

CREATE TABLE remetentes (
    id                   TEXT NOT NULL PRIMARY KEY,
    nome                 TEXT NOT NULL,
    cpf                  TEXT,
    classificacao_padrao TEXT CHECK (classificacao_padrao IN
                         ('tributavel','pessoal','reembolso','repasse_terceiros')),
    titular_remetente_id TEXT REFERENCES remetentes(id),  -- mãe paga a sessão do filho
    observacoes          TEXT,
    criado_em            INTEGER NOT NULL
) AS Remetente;

CREATE UNIQUE INDEX uq_remetentes_cpf ON remetentes (cpf) WHERE cpf IS NOT NULL;

CREATE TABLE apuracoes_mensais (
    id              TEXT NOT NULL PRIMARY KEY,
    competencia     TEXT NOT NULL,
    versao          INTEGER NOT NULL DEFAULT 1,
    status          TEXT NOT NULL DEFAULT 'rascunho'
                    CHECK (status IN ('rascunho','fechada','substituida')),

    receita_bruta_centavos               INTEGER NOT NULL,
    despesas_livro_caixa_centavos        INTEGER NOT NULL,  -- já com trava de 20%
    saldo_negativo_anterior_centavos     INTEGER NOT NULL DEFAULT 0,
    saldo_negativo_utilizado_centavos    INTEGER NOT NULL DEFAULT 0,
    saldo_negativo_transportado_centavos INTEGER NOT NULL DEFAULT 0,
    inss_centavos                        INTEGER NOT NULL,
    qtde_dependentes                     INTEGER NOT NULL,
    deducao_dependentes_centavos         INTEGER NOT NULL,
    desconto_simplificado_centavos       INTEGER NOT NULL,

    -- os dois cenários, ambos gravados; o app mostra por que escolheu
    imposto_cenario_real_centavos         INTEGER NOT NULL,
    imposto_cenario_simplificado_centavos INTEGER NOT NULL,
    cenario_aplicado TEXT NOT NULL CHECK (cenario_aplicado IN ('real','simplificado')),

    base_calculo_centavos       INTEGER NOT NULL,
    aliquota_bp                 INTEGER NOT NULL,
    parcela_deduzir_centavos    INTEGER NOT NULL,
    imposto_apurado_centavos    INTEGER NOT NULL,
    redutor_lei_centavos        INTEGER NOT NULL DEFAULT 0,  -- Lei 15.270/2025:
    imposto_devido_centavos     INTEGER NOT NULL,            -- incide sobre o IMPOSTO
    imposto_diferido_anterior_centavos INTEGER NOT NULL DEFAULT 0,  -- mínimo do DARF
    imposto_diferido_centavos          INTEGER NOT NULL DEFAULT 0,
    isento                      INTEGER NOT NULL DEFAULT 0,

    tabela_irpf_id      INTEGER NOT NULL REFERENCES cat_tabelas_irpf(id),
    catalogo_versoes_snapshot TEXT NOT NULL,  -- JSON: versão de cada catálogo usado
    parametros_snapshot TEXT NOT NULL,        -- JSON
    motor_versao        TEXT NOT NULL,        -- semver do motor
    app_versao          TEXT NOT NULL,
    calculada_em        INTEGER NOT NULL,
    fechada_em          INTEGER,
    UNIQUE (competencia, versao)
) AS ApuracaoLocal;

CREATE UNIQUE INDEX uq_apuracao_ativa
    ON apuracoes_mensais (competencia) WHERE status != 'substituida';

CREATE TABLE lancamentos (
    id                   TEXT NOT NULL PRIMARY KEY,
    transacao_id         TEXT UNIQUE REFERENCES transacoes(id),  -- NULL = manual
    competencia          TEXT NOT NULL,          -- 'YYYY-MM'
    data_recebimento     TEXT NOT NULL,
    valor_centavos       INTEGER NOT NULL CHECK (valor_centavos > 0),
    classificacao        TEXT NOT NULL CHECK (classificacao IN
                         ('tributavel','pessoal','reembolso','repasse_terceiros')),
    remetente_id         TEXT REFERENCES remetentes(id),
    cpf_pagador          TEXT,   -- snapshot: e-CAC exige CPF POR LANÇAMENTO
    nome_pagador         TEXT,   -- e o cadastro do remetente pode mudar depois
    origem_classificacao TEXT NOT NULL DEFAULT 'manual'
                         CHECK (origem_classificacao IN
                         ('manual','sugestao_aceita','regra_remetente')),
    apuracao_id          TEXT REFERENCES apuracoes_mensais(id),
    criado_em            INTEGER NOT NULL,
    atualizado_em        INTEGER NOT NULL
) AS Lancamento;

CREATE INDEX idx_lancamentos_comp ON lancamentos (competencia);

CREATE TABLE historico_classificacao (
    id            INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    lancamento_id TEXT NOT NULL REFERENCES lancamentos(id),
    de            TEXT,
    para          TEXT NOT NULL,
    motivo        TEXT,
    criado_em     INTEGER NOT NULL
) AS HistoricoClassificacao;

CREATE TABLE despesas_livro_caixa (
    id                TEXT NOT NULL PRIMARY KEY,
    rubrica_codigo    TEXT NOT NULL REFERENCES cat_rubricas(codigo),
    competencia       TEXT NOT NULL,
    data_pagamento    TEXT NOT NULL,            -- regime de caixa
    valor_centavos    INTEGER NOT NULL CHECK (valor_centavos > 0),
    valor_dedutivel_centavos INTEGER NOT NULL,  -- após trava de home office
    descricao         TEXT,
    home_office       INTEGER NOT NULL DEFAULT 0,
    anexo_path        TEXT,                     -- caminho local; Fase 2
    apuracao_id       TEXT REFERENCES apuracoes_mensais(id),
    criado_em         INTEGER NOT NULL
) AS DespesaLivroCaixa;

CREATE INDEX idx_despesas_comp ON despesas_livro_caixa (competencia);

CREATE TABLE pagamentos_inss (
    id             TEXT NOT NULL PRIMARY KEY,
    competencia    TEXT NOT NULL,               -- mês do PAGAMENTO efetivo
    valor_centavos INTEGER NOT NULL CHECK (valor_centavos > 0),
    observacao     TEXT,
    criado_em      INTEGER NOT NULL
) AS PagamentoInss;

CREATE TABLE dependentes (
    id              TEXT NOT NULL PRIMARY KEY,
    nome            TEXT NOT NULL,
    vigencia_inicio TEXT NOT NULL,
    vigencia_fim    TEXT,
    criado_em       INTEGER NOT NULL
) AS Dependente;
-- O VALOR da dedução por dependente é parâmetro do catálogo versionado.

-- ─── Apuração e DARF ────────────────────────────────────────────────

CREATE TABLE darfs (
    id                  TEXT NOT NULL PRIMARY KEY,
    apuracao_id         TEXT NOT NULL REFERENCES apuracoes_mensais(id),
    codigo_receita      TEXT NOT NULL DEFAULT '0190',
    competencia         TEXT NOT NULL,
    valor_centavos      INTEGER NOT NULL,
    vencimento          TEXT NOT NULL,   -- último dia útil do mês seguinte, antecipado
    vencimento_antecipado INTEGER NOT NULL DEFAULT 0,
    codigo_barras       TEXT,
    status              TEXT NOT NULL DEFAULT 'gerado'
                        CHECK (status IN ('gerado','pago','vencido','cancelado')),
    pago_em             TEXT,
    valor_pago_centavos INTEGER,          -- p/ o relatório anual fechar ao centavo
    criado_em           INTEGER NOT NULL
) AS DarfLocal;

CREATE INDEX idx_darfs_venc ON darfs (vencimento) WHERE status = 'gerado';

-- ─── Operação local ─────────────────────────────────────────────────

CREATE TABLE notificacoes_locais (
    id            TEXT NOT NULL PRIMARY KEY,
    tipo          TEXT NOT NULL CHECK (tipo IN
                  ('lembrete_darf','lembrete_importacao','radar_pf_cnpj','backup','sistema')),
    referencia_id TEXT,
    agendada_para INTEGER NOT NULL,
    os_notif_id   INTEGER,               -- id devolvido pelo agendador do SO
    status        TEXT NOT NULL DEFAULT 'agendada'
                  CHECK (status IN ('agendada','disparada','cancelada')),
    criado_em     INTEGER NOT NULL
) AS NotificacaoLocal;

CREATE TABLE backup_estado (
    id              INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    ultima_seq      INTEGER,
    ultimo_hash     TEXT,
    ultimo_em       INTEGER,
    formato_versao  INTEGER,
    tamanho_bytes   INTEGER,
    resultado       TEXT CHECK (resultado IN ('ok','falha','pendente')),
    erro_detalhe    TEXT
) AS BackupEstado;

CREATE TABLE envios_suporte (           -- bucket é write-only: o registro vive aqui
    id               TEXT NOT NULL PRIMARY KEY,
    arquivo_nome     TEXT NOT NULL,
    motivo           TEXT NOT NULL,
    consentimento_em INTEGER NOT NULL,
    enviado_em       INTEGER,
    path_remoto      TEXT,
    expira_em        INTEGER NOT NULL
) AS EnvioSuporte;

CREATE TABLE auditoria (
    id          INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    entidade    TEXT NOT NULL,
    entidade_id TEXT,
    acao        TEXT NOT NULL CHECK (acao IN ('criar','atualizar','excluir','recalcular')),
    detalhe     TEXT,                   -- JSON
    criado_em   INTEGER NOT NULL
) AS Auditoria;
